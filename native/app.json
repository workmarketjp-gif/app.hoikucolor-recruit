{
  "expo": {
    "name": "Hoiku Color",
    "slug": "hoiku-color",
    "version": "0.1.0",
    "scheme": "hoikucolor",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Hoiku Colorの個人情報を保護するためFace IDを使用します。"
        }
      ],
      [
        "@clerk/expo",
        {
          "appleSignIn": true
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "応募書類を撮影するためカメラを使用します。",
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "jp.hoikucolor.jobseeker",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "jp.hoikucolor.jobseeker",
      "versionCode": 2
    },
    "extra": {
      "eas": {
        "projectId": "507c2498-2098-4e4c-9699-75c494f00c47"
      },
      "router": {}
    },
    "owner": "workmarketjp"
  }
}
